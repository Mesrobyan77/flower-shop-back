# ---------- server ----------
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ---------- database ----------
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://mesrobyankhachik2_db_user:IgY63OeNA3JDTt19@anahitflower.me3iadv.mongodb.net/?retryWrites=true&w=majority&appName=AnahitFlower
MONGODB_DB=anahit_flower

# ---------- auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
# Not applied: the session and guest cookies are host-only on purpose, so a
# deployment can never widen them to a whole registrable domain.
COOKIE_DOMAIN=localhost
# How xf_refresh (sessions) and xf_sid (guest baskets) may travel.
#   lax    - default; the cookie only leaves with a same-site request. Correct
#            when the storefront is served from the API's own site, including
#            through a proxy.
#   none   - only for a storefront on a DIFFERENT registrable domain than this
#            API (e.g. Netlify frontend -> Render API). Always paired with Secure,
#            which is forced and cannot be turned off; browsers that block
#            third-party cookies will still refuse it.
#   strict - never sent from another site at all, including top-level links.
COOKIE_SAMESITE=lax
# auto = Secure only when NODE_ENV=production. 'false' is refused in production.
COOKIE_SECURE=auto

