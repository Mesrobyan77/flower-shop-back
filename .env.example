# ---------- server ----------
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# ---------- database ----------
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xch_flower?retryWrites=true&w=majority
MONGODB_DB=xch_flower

# ---------- auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost

# ---------- MinIO ----------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xch-flower
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# ---------- commerce ----------
CURRENCY=AMD
CURRENCY_SYMBOL=֏
PARCEL_FEE=1500
FREE_PARCEL_THRESHOLD=25000
QUICK_FEE=2500
RURAL_SURCHARGE=3000

# ---------- seed ----------
SEED_ADMIN_EMAIL=admin@xch-flower.am
SEED_ADMIN_PASSWORD=Admin123!
