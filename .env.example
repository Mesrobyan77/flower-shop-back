# ---------- server ----------
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# ---------- database ----------
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/anahit_flower?retryWrites=true&w=majority
MONGODB_DB=anahit_flower

# ---------- auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost

# ---------- Cloudinary (media) ----------
# From the Cloudinary dashboard. Leave empty to run on the seeded local
# artwork - only admin uploads under /admin/media need real credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder every upload is nested under, so one cloud can host several sites.
CLOUDINARY_FOLDER=anahit-flower

# ---------- commerce ----------
CURRENCY=AMD
CURRENCY_SYMBOL=֏
PARCEL_FEE=1500
FREE_PARCEL_THRESHOLD=25000
QUICK_FEE=2500
RURAL_SURCHARGE=3000

# ---------- seed ----------
# svg = generated placeholder artwork, jpg = photos pulled by
# frontend/scripts/fetch-seed-photos.mjs
SEED_IMAGE_EXT=svg
# 'local' serves the artwork from frontend/public/images/seed; 'cloudinary' points
# the catalogue at the uploads made by 'npm run seed:images'. A deployment wants
# cloudinary - the .jpg photography is untracked, so a fresh clone cannot serve it.
SEED_IMAGE_SOURCE=local
# Development demo pair - convenient locally. With NODE_ENV=production BOTH of
# these values are refused at boot and must be replaced by an explicit pair you
# choose (password: at least 16 characters).
SEED_ADMIN_EMAIL=admin@anahit-flower.am
SEED_ADMIN_PASSWORD=Admin123!

# ---------- production only ----------
# With NODE_ENV=production the API validates its configuration at boot and refuses
# to start on anything unsafe (each message names the variable, never its value):
#   * JWT_SECRET / JWT_REFRESH_SECRET: two independent random strings of at least
#     32 characters - the placeholders above are rejected.
#   * MONGODB_URI: mongodb+srv:// is encrypted by default, a plain mongodb:// URI
#     must carry ?tls=true.
#   * MONGODB_TLS=disabled: explicit opt-out of the encryption requirement, for a
#     database reachable only over a private network.
#   * CORS_ORIGINS: explicit origins only; "*" is refused while credentialed CORS
#     is enabled.
#   * SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD: the development demo pair above is
#     rejected - a deployment that seeds an admin must state its own address and
#     a password of at least 16 characters, or boot fails closed.
# Deploy behind a reverse proxy that terminates TLS and forwards X-Forwarded-For
# (the API trusts one proxy hop). Indexes are never created automatically outside
# development, so run `npm run db:indexes` once per database (it is idempotent).
