# ---------- online payments ----------
# The public storefront origin - payment return URLs are built from it, so in
# production it must be the real domain (the API refuses to boot otherwise
# while any online payment method is enabled).
# ---------- on-demand cache invalidation ----------
APP_FRONTEND_URL=http://localhost:3000

# On-demand storefront cache invalidation. Generate any long random value and put
# the same value in the frontend's .env under the same name. Empty disables the
# notification: admin edits then only reach shoppers when the page's ISR TTL
# expires (60s product, 120s home, 3600s sitemap).
FRONTEND_REVALIDATE_SECRET=

# Idram merchant credentials. IdramId (EDP_REC_ACCOUNT) and SECRET_KEY are
# provisioned by Idram together with the fixed SUCCESS_URL / FAIL_URL /
# RESULT_URL (RESULT_URL must point at <api origin>/api/payments/idram/result).
# Leave both empty to hide Idram; setting exactly one is refused at boot.
# PAYMENT_URL is the hosted payment page the buyer is POSTed to.
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
IDRAM_PAYMENT_URL=https://money.idram.am/payment.aspx

# ArCa (Compass Plus EPG) REST credentials. API_BASE_URL is the test gateway by
# default - production is https://ipay.arca.am/payment/rest. Leave both empty to
# hide the card tab; setting exactly one is refused at boot.
# AMOUNT_MULTIPLIER converts the AMD order total to the gateway's minor
# denomination (100 per the EPG manual; set to 1 only if the gateway account is
# configured to accept whole dram).
ARCA_API_BASE_URL=https://ipaytest.arca.am:8445/payment/rest
ARCA_USERNAME=
ARCA_PASSWORD=
ARCA_AMOUNT_MULTIPLIER=100# On-demand storefront cache invalidation. Same value as the storefront .env.
# Empty means the API never notifies the storefront; ISR TTLs alone decide.
FRONTEND_REVALIDATE_SECRET=

