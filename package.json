{
  "name": "anahit-flower-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AURELIA - commerce API (Express + TypeScript + MongoDB + Cloudinary)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/index.ts",
    "seed:fresh": "tsx src/seed/index.ts --fresh",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run cart:concurrency",
    "dev:memory": "tsx src/scripts/devServer.ts",
    "dev:memory:standalone": "tsx src/scripts/devServer.ts --standalone",
    "smoke": "tsx src/scripts/smoke.ts",
    "payment:security": "tsx src/scripts/paymentSecurity.ts",
    "stock:concurrency": "tsx src/scripts/stockConcurrency.ts",
    "stock:concurrency:no-tx": "tsx src/scripts/stockConcurrency.ts --no-transactions",
    "points:concurrency": "tsx src/scripts/pointsConcurrency.ts",
    "points:concurrency:no-tx": "tsx src/scripts/pointsConcurrency.ts --no-transactions",
    "idempotency:concurrency": "tsx src/scripts/idempotencyConcurrency.ts",
    "idempotency:concurrency:no-tx": "tsx src/scripts/idempotencyConcurrency.ts --no-transactions",
    "cart:concurrency": "tsx src/scripts/cartConcurrency.ts",
    "mongo:local": "tsx src/scripts/localMongo.ts",
    "db:indexes": "tsx src/scripts/syncIndexes.ts",
    "db:backup": "tsx src/scripts/dbBackup.ts",
    "db:restore": "tsx src/scripts/dbRestore.ts",
    "security:check": "tsx src/scripts/securityCheck.ts",
    "security:check:prod": "tsx src/scripts/securityCheck.ts --prod",
    "refresh:tests": "tsx src/scripts/refreshTokenFlow.ts",
    "seed:images": "tsx src/scripts/uploadSeedImages.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.1",
    "compression": "1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nanoid": "^3.3.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
